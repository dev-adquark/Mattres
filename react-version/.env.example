# Copy to .env.local for local development. Never commit real values -
# .env* is already gitignored (see .gitignore).

# --- Vercel Cron (existing) ---
# Bearer secret Vercel Cron sends when invoking app/api/cron/* routes.
CRON_SECRET=

# --- RTINGS/Apify data pipeline ---
# Server-only. Never exposed to the client bundle, never logged. Get this
# from https://console.apify.com/settings/integrations - rotate it if it
# is ever pasted somewhere outside a secrets manager (e.g. into a chat).
APIFY_API_TOKEN=
# The RTINGS actor: crawlerbros/rtings-scraper. The pipeline refuses any
# other actor (this id or the crawlerbros/rtings-scraper slug only).
APIFY_RTINGS_ACTOR_ID=dCa1uCOn8ZtEkUamC
# Optional. Items requested per category run (default 50, hard cap 200).
# Each result is billed by Apify - see docs/RTINGS_SYNC.md "Cost".
RTINGS_SYNC_MAX_ITEMS=
# Optional. Per-run Apify spending cap in USD passed to the actor run
# (default 1.5, never above 10).
RTINGS_SYNC_MAX_CHARGE_USD=

# --- Admin endpoints ---
# Bearer secret for POST/GET /api/admin/rtings/*. Deliberately separate
# from CRON_SECRET so a leaked cron secret can't also trigger an
# on-demand sync.
ADMIN_API_SECRET=

# --- Database (Supabase) ---
# Server-only. SUPABASE_SECRET_KEY bypasses row-level security entirely -
# never expose it to the client, never log it, rotate it in Supabase's
# dashboard (Settings -> API) if it's ever pasted anywhere outside a
# secrets manager. The app falls back to the git-committed
# lib/data/mattress-catalog.json snapshot when these aren't set, or if a
# query fails - see lib/db/mattressRepo.ts.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only needed to run the repo-root scripts/apply-db-migration.js (schema setup) - the
# running app never uses a direct Postgres connection, only the Supabase
# client over HTTPS (see lib/db/supabaseClient.ts's own comment on why).
DIRECT_URL=

